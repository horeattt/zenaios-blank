# Copiază în .env și înlocuiește valorile. Nu pune chei reale în Git.
# O instalare = un spital. Nu copia .env între spitale.

DATABASE_URL=postgres://zenaios:change-me@localhost:5432/zenaios
PORT=3000

# 32 de octeți, base64. Generează cu:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_DATA_KEY=

# Secret de server pentru a proviziona un spital nou. Nu este parolă de utilizator.
PROVISION_TOKEN=

COOKIE_SECURE=0
DATA_DIR=./data/pglite
